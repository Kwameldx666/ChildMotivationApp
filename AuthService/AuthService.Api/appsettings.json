{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ServicesEndpoints": {
    "Google": {
      "GoogleToken": "https://oauth2.googleapis.com/token",
      "GoogleUserInfo": "https://www.googleapis.com/oauth2/v3/userinfo",
      "GoogleAuthorize": "https://accounts.google.com/o/oauth2/v2/auth"
    }
  },
  "JwtBearer": {
    "Issuer": "https://auth-service:8080/",
    "Audience": "https://gateway-service:8080",
    "AccessTokenLifetime": 10,
    "Secret": "development-secret-change-me",
    "RefreshTokenLength": 150,
    "RefreshTokenLifetime": 7
  },
  "Quartz": {
    "CleanJob": {
      "Key": "CleanRefreshTokenJob",
      "IdentityTrigger": "CleanRefreshTokenJob-trigger",
      "IntervalHours": 60
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:8080/auth-service/auth/google/callback",
      "PostSignInRedirectUri": "http://localhost:3000/auth"
    }
  },
  "Smtp": {
    "Host": "mailhog",
    "Port": 1025,
    "UserName": "",
    "Password": "",
    "FromEmail": "noreply@familytasks.local",
    "FromName": "FamilyTasks",
    "UseSsl": false
  },
  "AllowedHosts": "*"
