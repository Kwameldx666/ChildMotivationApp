{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Services": {
    "Auth": {
      "BaseUrl": "http://localhost:8080",
      "TimeoutSeconds": 30,
      "MaxRetries": 3
    },
    "User": {
      "BaseUrl": "http://localhost:8082",
      "TimeoutSeconds": 30,
      "MaxRetries": 3
    },
    "Task": {
      "BaseUrl": "http://localhost:8083",
      "TimeoutSeconds": 30,
      "MaxRetries": 3
    },
    "Shop": {
      "BaseUrl": "http://localhost:8091",
      "TimeoutSeconds": 30,
      "MaxRetries": 3
    },
    "Ai": {
      "BaseUrl": "http://localhost:8095",
      "TimeoutSeconds": 90,
      "MaxRetries": 3
    },
    "Notification": {
      "BaseUrl": "http://localhost:8092",
      "TimeoutSeconds": 30,
      "MaxRetries": 3
    }
  },
  "ServiceEndpoints": {
    "AuthService": {
      "Register": "auth-service/register",
      "Login": "auth-service/login",
      "Refresh": "auth-service/refresh",
      "GoogleAuthorize": "auth-service/google/authorize",
      "GitHubAuthorize": "auth-service/github/authorize",
      "DiscordAuthorize": "auth-service/discord/authorize",
      "Session": "auth-service/session",
      "Pending": "auth-service/pending",
      "GoogleComplete": "auth-service/google/complete",
      "GitHubComplete": "auth-service/github/complete",
      "DiscordComplete": "auth-service/discord/complete",
      "ConfirmEmail": "auth-service/confirm-email",
      "ResendConfirmation": "auth-service/resend-confirmation",
      "RegisterChild": "auth-service/register-child"
    },
    "UserService": {
      "Profile": "user-service/profile",
      "ProfileMe": "user-service/profile/me",
      "FamilyMembers": "user-service/profile/{userId}/family-members",
      "FamilyMembersMe": "user-service/profile/me/family-members",
      "SubscriptionMe": "user-service/subscription/me",
      "Subscription": "user-service/subscription/{userId}",
      "SubscriptionChange": "user-service/subscription/change",
      "SubscriptionCancel": "user-service/subscription/cancel",
      "SubscriptionTiers": "user-service/subscription/tiers"
    },
    "TaskService": {
      "Tasks": "task-service/tasks",
      "Missions": "task-service/missions",
      "Achievements": "task-service/achievements"
    },
    "ShopService": {
      "Products": "shop-service/products",
      "Orders": "shop-service/orders"
    },
    "AiService": {
      "TaskSuggestions": "ai-service/task-suggestions",
      "RewardSuggestions": "ai-service/reward-suggestions",
      "Chat": "ai-service/chat",
      "Analytics": "ai-service/analytics"
    },
    "NotificationService": {
      "Base": "/api/usernotifications",
      "SendBase": "/api/notifications"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:4000",
      "https://localhost:4000",
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "JwtBearer": {
    "Audience": "https://gateway-service:8080",
    "Issuer": "https://auth-service:8080/",
    "AccessTokenLifetime": 15
  },
  "AllowedHosts": "*"
}
