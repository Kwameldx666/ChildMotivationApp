{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Services": {
    "AuthService": "http://localhost:7265",
    "UserService": "http://localhost:5110"
  },
  "ServiceEndpoints": {
    "AuthService": {
      "Register": "auth-service/auth/register",
      "Login": "auth-service/auth/login",
      "Refresh": "auth-service/auth/refresh",
      "GoogleAuthorize": "auth-service/auth/google/authorize",
      "GoogleCallback": "auth-service/auth/google/callback",
      "GoogleSession": "auth-service/auth/google/session",
      "GooglePending": "auth-service/auth/google/pending",
      "GoogleComplete": "auth-service/auth/google/complete"
    },
    "UserService": {
      "Profile": "user-service/profile",
      "ProfileMe": "user-service/profile/me"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "JwtBearer": {
    "Audience": "https://gateway-service:8080",
    "Issuer": "https://auth-service:8080/",
    "AccessTokenLifetime": 15,
    "Secret": ""
  },
  "AllowedHosts": "*"
}
