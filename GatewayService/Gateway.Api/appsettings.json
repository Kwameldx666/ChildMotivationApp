{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Services": {
    "AuthService": "http://localhost:7265",
    "UserService": "http://localhost:5110"
  },
  "ServiceEndpoints": {
    "AuthService": {
      "Register": "auth-service/auth/register",
      "Login": "auth-service/auth/login",
      "Refresh": "auth-service/auth/refresh"
    },
    "UserService": {
      "Profile": "user-service/profile",
      "ProfileMe": "user-service/profile/me"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "JwtBearer": {
    "Audience": "https://gateway-service:8080",
    "Issuer": "https://auth-service:8080/",
    "AccessTokenLifetime": 15,
    "Secret": "development-secret-change-me"
  },
  "AllowedHosts": "*"
}
