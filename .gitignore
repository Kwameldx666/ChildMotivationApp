# ----------------------------
# Root .gitignore for this mono-repo (dotnet + Node + IDEs)
# ----------------------------

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# ----------------------------
# Editors & IDEs
# ----------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.DotSettings.user
*.sln.iml
*.userprefs

# ----------------------------
# Build outputs (dotnet)
# ----------------------------
**/bin/
**/obj/
**/artifacts/
**/publish/
**/wwwroot/
**/TestResults/
**/GeneratedFiles/

# ----------------------------
# NuGet / packages
# ----------------------------
packages/
*.nupkg
.nuget/
.project.lock.json
project.fragment.lock.json

# ----------------------------
# .NET specific
# ----------------------------
*.dbmdl
*.jfm

# ----------------------------
# Logs and diagnostics
# ----------------------------
logs/
*.log
*.tlog
*.vsp
*.vspx
*.psess
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------
# Node / Frontend
# ----------------------------
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/.swc/
**/.cache/
**/.parcel-cache/
**/*.tsbuildinfo

# Next.js
.next/

# ----------------------------
# Test / coverage
# ----------------------------
coverage/
**/coverage/
.vscode-test/

# ----------------------------
# Environment files
# ----------------------------
.env
.env.*
# keep examples
!.env.example
!.env.sample
!.env.template
# local env files - DO NOT COMMIT
.env.local
.env.development.local
.env.production.local

# ----------------------------
# Misc
# ----------------------------
*.swp
*~
*.lock
node-repl-history
.pnpm-store/
.pnp.*

# Do not ignore lockfiles (we keep them for reproducible installs):
# package-lock.json, pnpm-lock.yaml, yarn.lock

# project-specific / misc
fq_gateway/

# End of file

