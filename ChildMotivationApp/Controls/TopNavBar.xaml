<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChildMotivationApp.Controls.TopNavBar"
             x:Name="This">
    <Grid Padding="16,10" RowDefinitions="Auto">
        <Border BackgroundColor="#FFFFFFFF" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#20000000" Radius="18" Offset="0,2"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,Auto,*,*" Padding="8,6">
                <!-- Главная -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Border BackgroundColor="{Binding Source={x:Reference This}, Path=HomeBg}" WidthRequest="36" HeightRequest="36" StrokeThickness="0">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <!-- Monochrome Home icon -->
                        <Path WidthRequest="18" HeightRequest="18" Aspect="Uniform"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z">
                            <Path.Fill>
                                <SolidColorBrush Color="{Binding Source={x:Reference This}, Path=HomeText}"/>
                            </Path.Fill>
                        </Path>
                    </Border>
                    <Label Text="Главная" FontSize="12" TextColor="{Binding Source={x:Reference This}, Path=HomeText}" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Награды -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Border BackgroundColor="{Binding Source={x:Reference This}, Path=RewardsBg}" WidthRequest="36" HeightRequest="36" StrokeThickness="0">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <!-- Monochrome Star icon -->
                        <Path WidthRequest="18" HeightRequest="18" Aspect="Uniform"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Data="M12 17.27L18.18 21 16.54 13.97 22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z">
                            <Path.Fill>
                                <SolidColorBrush Color="{Binding Source={x:Reference This}, Path=RewardsText}"/>
                            </Path.Fill>
                        </Path>
                    </Border>
                    <Label Text="Награды" FontSize="12" TextColor="{Binding Source={x:Reference This}, Path=RewardsText}" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRewardsTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Центральная кнопка + -->
                <Grid Grid.Column="2" WidthRequest="56" HeightRequest="56">
                    <Border StrokeThickness="0">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Radius="20" Brush="#408B5CF6" Offset="0,6"/>
                        </Border.Shadow>
                        <Label Text="+" FontSize="22" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAddTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Статистика -->
                <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <Border BackgroundColor="{Binding Source={x:Reference This}, Path=StatsBg}" WidthRequest="36" HeightRequest="36" StrokeThickness="0">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <!-- Monochrome Bar Chart icon -->
                        <Path WidthRequest="18" HeightRequest="18" Aspect="Uniform"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Data="M3 17h2V7H3v10zm4 0h2V5H7v12zm4 0h2V8h-2v9zm4 0h2v-5h-2v5zm4 0h2v-2h-2v2z">
                            <Path.Fill>
                                <SolidColorBrush Color="{Binding Source={x:Reference This}, Path=StatsText}"/>
                            </Path.Fill>
                        </Path>
                    </Border>
                    <Label Text="Статистика" FontSize="12" TextColor="{Binding Source={x:Reference This}, Path=StatsText}" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStatsTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <!-- Профиль -->
                <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                    <Border BackgroundColor="{Binding Source={x:Reference This}, Path=ProfileBg}" WidthRequest="36" HeightRequest="36" StrokeThickness="0">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <!-- Monochrome User icon -->
                        <Path WidthRequest="18" HeightRequest="18" Aspect="Uniform"
                              HorizontalOptions="Center" VerticalOptions="Center"
                              Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z">
                            <Path.Fill>
                                <SolidColorBrush Color="{Binding Source={x:Reference This}, Path=ProfileText}"/>
                            </Path.Fill>
                        </Path>
                    </Border>
                    <Label Text="Профиль" FontSize="12" TextColor="{Binding Source={x:Reference This}, Path=ProfileText}" HorizontalOptions="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>