<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ChildMotivationApp"
             x:Class="ChildMotivationApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Gradients.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/ResponsiveStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/NavigationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Глобальный шрифт для поддержки кириллицы на Windows -->
            <OnPlatform x:Key="DefaultFontFamily" x:TypeArguments="x:String">
                <On Platform="iOS" Value="San Francisco" />
                <On Platform="Android" Value="sans-serif" />
                <On Platform="WinUI" Value="Segoe UI" />
            </OnPlatform>
        </ResourceDictionary>
    </Application.Resources>
</Application>
