<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ========================================= -->
    <!-- Shell Navigation Styles -->
    <!-- ========================================= -->
    
    <!-- Beautiful Navigation Bar Style -->
    <Style TargetType="Shell">
        <Setter Property="Shell.NavBarIsVisible" Value="True" />
        <Setter Property="Shell.NavBarHasShadow" Value="True" />
        
        <!-- Navigation Bar Colors with Gradient Effect -->
        <Setter Property="Shell.ForegroundColor" Value="White" />
        <Setter Property="Shell.TitleColor" Value="White" />
        
        <!-- Tab Bar Styling -->
        <Setter Property="Shell.TabBarBackgroundColor" Value="White" />
        <Setter Property="Shell.TabBarForegroundColor" Value="#6B7280" />
        <Setter Property="Shell.TabBarTitleColor" Value="#6B7280" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="#9CA3AF" />
        
        <!-- Flyout Styling -->
        <Setter Property="Shell.FlyoutBackgroundColor" Value="White" />
    </Style>

    <!-- Navigation Page Title Style -->
    <Style x:Key="NavigationPageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Navigation Back Button Style -->
    <Style x:Key="NavigationBackButton" TargetType="Button">
        <Setter Property="Text" Value="?" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <!-- ========================================= -->
    <!-- Adaptive Content Container Styles -->
    <!-- ========================================= -->
    
    <!-- Mobile Content Container -->
    <Style x:Key="MobileContentContainer" TargetType="StackLayout">
        <Setter Property="Padding" Value="16,20,16,120" />
        <Setter Property="Spacing" Value="20" />
    </Style>

    <!-- Tablet Content Container -->
    <Style x:Key="TabletContentContainer" TargetType="StackLayout">
        <Setter Property="Padding" Value="24,32,24,80" />
        <Setter Property="Spacing" Value="24" />
    </Style>

    <!-- Desktop Content Container -->
    <Style x:Key="DesktopContentContainer" TargetType="StackLayout">
        <Setter Property="Padding" Value="32,40,32,40" />
        <Setter Property="Spacing" Value="28" />
    </Style>

    <!-- ========================================= -->
    <!-- Adaptive Card Styles -->
    <!-- ========================================= -->
    
    <!-- Mobile Cards -->
    <Style x:Key="MobileCard" TargetType="Frame">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Tablet Cards -->
    <Style x:Key="TabletCard" TargetType="Frame">
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Desktop Cards -->
    <Style x:Key="DesktopCard" TargetType="Frame">
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- ========================================= -->
    <!-- Navigation Button Styles -->
    <!-- ========================================= -->
    
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <Style x:Key="NavButtonPrimary" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="BackgroundColor" Value="#8B5CF6" />
    </Style>

    <Style x:Key="NavButtonSecondary" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="#8B5CF6" />
        <Setter Property="BorderColor" Value="#8B5CF6" />
        <Setter Property="BorderWidth" Value="2" />
    </Style>

    <!-- ========================================= -->
    <!-- Custom Navigation Bar Component -->
    <!-- ========================================= -->
    
    <!-- Beautiful Navigation Bar Container -->
    <Style x:Key="CustomNavigationBar" TargetType="Grid">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HeightRequest" Value="60" />
    </Style>

    <!-- Navigation Bar with Gradient Background -->
    <Style x:Key="GradientNavigationBar" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#8B5CF6" Offset="0.0" />
                    <GradientStop Color="#A78BFA" Offset="1.0" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#40000000" Radius="15" Offset="0,5" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>