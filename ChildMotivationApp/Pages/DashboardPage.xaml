<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ChildMotivationApp.Controls"
    BackgroundColor="#F8FAFC"
    Shell.NavBarIsVisible="False"
    Title="Family Dashboard">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <!-- Верхняя навигация -->
        <controls:TopNavBar Grid.Row="0" />

        <!-- Основной контент -->
        <ScrollView Grid.Row="1">
            <Grid ColumnDefinitions="2.5*,*" ColumnSpacing="20" Padding="20,16,20,100" RowSpacing="20">
            
                <!-- ЛЕВАЯ СТОРОНА - Активность и Задачи -->
                <VerticalStackLayout Grid.Column="0" Spacing="20">
                
                    <!-- 📈 Карта активности -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="24">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="20">
                            <!-- Заголовок -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="📊 Активность за неделю"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />
                                    <Label Text="Прогресс выполнения задач"
                                           FontSize="13"
                                           TextColor="#6B7280" />
                                </VerticalStackLayout>
                                
                                <!-- Кнопка фильтров -->
                                <Border Grid.Column="1"
                                        BackgroundColor="#F3F4F6"
                                        StrokeThickness="0"
                                        Padding="12,8"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Label Text="7 дней ▼"
                                           FontSize="13"
                                           TextColor="#6B7280"
                                           FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            
                            <!-- Место для графика с анимированными столбцами -->
                            <Grid HeightRequest="250" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="8">
                                <!-- Понедельник -->
                                <VerticalStackLayout Grid.Column="0">
                                    <BoxView BackgroundColor="#E5E7EB"
                                             HeightRequest="200"
                                             CornerRadius="6"
                                             VerticalOptions="End" />
                                    <Label Text="ПН"
                                           FontSize="11"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                                
                                <!-- Вторник -->
                                <VerticalStackLayout Grid.Column="1">
                                    <BoxView CornerRadius="6"
                                             HeightRequest="160"
                                             VerticalOptions="End">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#8B5CF6" Offset="0.0" />
                                                <GradientStop Color="#A78BFA" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    <Label Text="ВТ"
                                           FontSize="11"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                                
                                <!-- Среда -->
                                <VerticalStackLayout Grid.Column="2">
                                    <BoxView CornerRadius="6"
                                             HeightRequest="180"
                                             VerticalOptions="End">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#8B5CF6" Offset="0.0" />
                                                <GradientStop Color="#A78BFA" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    <Label Text="СР"
                                           FontSize="11"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                                
                                <!-- Четверг -->
                                <VerticalStackLayout Grid.Column="3">
                                    <BoxView CornerRadius="6"
                                             HeightRequest="220"
                                             VerticalOptions="End">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#8B5CF6" Offset="0.0" />
                                                <GradientStop Color="#A78BFA" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    <Label Text="ЧТ"
                                           FontSize="11"
                                           TextColor="#8B5CF6"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                                
                                <!-- Пятница -->
                                <VerticalStackLayout Grid.Column="4">
                                    <BoxView BackgroundColor="#E5E7EB"
                                             HeightRequest="140"
                                             CornerRadius="6"
                                             VerticalOptions="End"
                                             Opacity="0.5" />
                                    <Label Text="ПТ"
                                           FontSize="11"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                                
                                <!-- Суббота -->
                                <VerticalStackLayout Grid.Column="5">
                                    <BoxView BackgroundColor="#E5E7EB"
                                             HeightRequest="100"
                                             CornerRadius="6"
                                             VerticalOptions="End"
                                             Opacity="0.5" />
                                    <Label Text="СБ"
                                           FontSize="11"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                                
                                <!-- Воскресенье -->
                                <VerticalStackLayout Grid.Column="6">
                                    <BoxView BackgroundColor="#E5E7EB"
                                             HeightRequest="80"
                                             CornerRadius="6"
                                             VerticalOptions="End"
                                             Opacity="0.5" />
                                    <Label Text="ВС"
                                           FontSize="11"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 📝 Карта последних задач -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="24">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="🎯 Последние задачи"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Grid.Column="1"
                                       Text="Все задачи →"
                                       FontSize="13"
                                       TextColor="#8B5CF6"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </Grid>
                            
                            <!-- Список задач -->
                            <VerticalStackLayout Spacing="12">
                                <!-- Задача 1 -->
                                <Border BackgroundColor="#F9FAFB"
                                        StrokeThickness="0"
                                        Padding="16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="40"
                                                HeightRequest="40"
                                                BackgroundColor="#DBEAFE"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="🧹"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="Убрать комнату"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F2937" />
                                            <Label Text="Маша • до 18:00"
                                                   FontSize="12"
                                                   TextColor="#6B7280" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                BackgroundColor="#FEF3C7"
                                                StrokeThickness="0"
                                                Padding="10,6"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="В процессе"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#92400E" />
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- Задача 2 -->
                                <Border BackgroundColor="#F9FAFB"
                                        StrokeThickness="0"
                                        Padding="16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="40"
                                                HeightRequest="40"
                                                BackgroundColor="#DCFCE7"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="📚"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="Сделать домашнее задание"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F2937" />
                                            <Label Text="Петя • до завтра"
                                                   FontSize="12"
                                                   TextColor="#6B7280" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2"
                                                BackgroundColor="#D1FAE5"
                                                StrokeThickness="0"
                                                Padding="10,6"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="Готово ✓"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#065F46" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ПРАВАЯ СТОРОНА - Боковая панель -->
                <VerticalStackLayout Grid.Column="1" Spacing="20">
                
                    <!-- 👨‍👩‍👧 Семейная карта -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="👨‍👩‍👧‍👦 Моя семья"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937" />
                        
                            <!-- Член семьи -->
                            <Border BackgroundColor="#F9FAFB"
                                    StrokeThickness="0"
                                    Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <Ellipse />
                                        </Border.StrokeShape>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#EC4899" Offset="0.0" />
                                                <GradientStop Color="#F472B6" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="👧"
                                               FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Маша"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#1F2937" />
                                        <Label Text="8 лет • 45 очков"
                                               FontSize="11"
                                               TextColor="#6B7280" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            
                            <Button Text="➕ Пригласить ребенка"
                                    FontSize="13"
                                    TextColor="#8B5CF6"
                                    BackgroundColor="#F5F3FF"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    BorderWidth="0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 🏆 Карта достижений -->
                    <Border StrokeThickness="0"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FBBF24" Offset="0.0" />
                                <GradientStop Color="#F59E0B" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#40F59E0B" Radius="20" Offset="0,8" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="16">
                            <Label Text="🏆 Достижения"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="327"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="Всего очков"
                                           FontSize="12"
                                           TextColor="White"
                                           Opacity="0.9" />
                                </VerticalStackLayout>
                                
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="18"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="Выполнено"
                                           FontSize="12"
                                           TextColor="White"
                                           Opacity="0.9" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ⚡ Быстрые действия -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="⚡ Быстрые действия"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937" />
                            
                            <Button Text="➕ Создать задачу"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    BorderWidth="0"
                                    Clicked="OnCreateTaskClicked">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#8B5CF6" Offset="0.0" />
                                        <GradientStop Color="#A78BFA" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                            
                            <Button Text="🎁 Выдать награду"
                                    TextColor="#8B5CF6"
                                    BackgroundColor="#F5F3FF"
                                    FontSize="14"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    BorderWidth="0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
