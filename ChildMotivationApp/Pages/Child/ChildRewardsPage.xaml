<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.Child.ChildRewardsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#FFF7ED"
    Title="Магазин радости">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Margin="20,24,20,16" Padding="20"
                BackgroundColor="#FFFFFF" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#19000000" Radius="18" Offset="0,6" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Выбери свою награду"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#C2410C" />
                    <Label Text="Копи очки и обменивай на веселье"
                           FontSize="14"
                           TextColor="#EA580C" />
                </VerticalStackLayout>

                <Border Grid.Column="1" BackgroundColor="#FFF1C7" StrokeThickness="0" Padding="16,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="✨" FontSize="24" />
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Твои очки" FontSize="12" TextColor="#C2410C" />
                            <Label Text="320" FontSize="18" FontAttributes="Bold" TextColor="#9A3412" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24" Padding="20,0,20,100">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#FFF1C7" Padding="14,6" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="Популярное" FontSize="14" FontAttributes="Bold" TextColor="#C2410C" />
                    </Border>
                    <Border BackgroundColor="#FFE4E6" Padding="14,6" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="Вкусняшки" FontSize="14" FontAttributes="Bold" TextColor="#BE123C" />
                    </Border>
                    <Border BackgroundColor="#DCFCE7" Padding="14,6" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Label Text="Развлечения" FontSize="14" FontAttributes="Bold" TextColor="#15803D" />
                    </Border>
                </HorizontalStackLayout>

                <CollectionView ItemsSource="{Binding Rewards}" SelectionMode="None"
                                ItemsLayout="VerticalGrid, 2">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,16,16" Padding="16" BackgroundColor="#FFFFFF" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#12000000" Radius="14" Offset="0,4" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                    <Label Text="{Binding Emoji}" FontSize="32" HorizontalOptions="Center" />
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#9A3412" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding Description}" FontSize="13" TextColor="#C2410C" HorizontalTextAlignment="Center" />
                                    <Border BackgroundColor="#FFF1C7" StrokeThickness="0" Padding="12,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                            <Image Source="https://img.icons8.com/color/48/coins.png" WidthRequest="20" HeightRequest="20" />
                                            <Label Text="{Binding PointsText}" FontSize="14" FontAttributes="Bold" TextColor="#C2410C" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
