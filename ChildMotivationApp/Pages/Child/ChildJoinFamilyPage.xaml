<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.Child.ChildJoinFamilyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F8F5FF"
    Shell.NavBarIsVisible="False">

    <Grid Padding="32,40">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8F5FF" Offset="0" />
                <GradientStop Color="#FDE7FF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout
            Spacing="24"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            MaximumWidthRequest="420">

            <Border
                BackgroundColor="White"
                Padding="28,32"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22000000" Radius="24" Offset="0,12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="28">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Border
                            WidthRequest="64"
                            HeightRequest="64"
                            BackgroundColor="#EDE9FE"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <Label
                                Text="👪"
                                FontSize="28"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <Label
                            x:Name="GreetingLabel"
                            Text="Присоединись к семье"
                            FontSize="24"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="#1E1B4B" />

                        <Label
                            x:Name="SubtitleLabel"
                            Text="Введи код приглашения от родителей"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="#6B7280" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="Код приглашения"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#4338CA" />

                        <Border
                            BackgroundColor="#F5F3FF"
                            Stroke="Transparent"
                            Padding="16,12"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="InviteCodeEntry"
                                Placeholder="Например, FAM123"
                                TextTransform="Uppercase"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#312E81"
                                PlaceholderColor="#9CA3AF"
                                BackgroundColor="Transparent"
                                HorizontalTextAlignment="Center" />
                        </Border>

                        <Label
                            Text="Попроси родителей поделиться кодом"
                            FontSize="12"
                            TextColor="#9CA3AF"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Button
                        Text="Присоединиться"
                        Clicked="OnJoinFamilyClicked"
                        CornerRadius="16"
                        HeightRequest="52"
                        FontAttributes="Bold"
                        TextColor="White">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#22C55E" Offset="0" />
                                <GradientStop Color="#16A34A" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button
                        Text="Ввести позже"
                        Clicked="OnSkipClicked"
                        CornerRadius="16"
                        HeightRequest="48"
                        FontAttributes="Bold"
                        TextColor="#6366F1"
                        BackgroundColor="#EEF2FF" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
