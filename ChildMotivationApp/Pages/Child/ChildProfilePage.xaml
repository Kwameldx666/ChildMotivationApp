<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.Child.ChildProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F3FF"
    Title="Мой профиль">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="20,32,20,120">
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#17000000" Radius="18" Offset="0,6" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                    <Border WidthRequest="96" HeightRequest="96" BackgroundColor="#EEF2FF" StrokeThickness="0">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Label Text="🦄" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="Лиза"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#4338CA" />
                        <Label Text="8 лет"
                               FontSize="16"
                               TextColor="#6366F1" />
                        <Border BackgroundColor="#EEF2FF" StrokeThickness="0" Padding="12,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label Text="🌟 Маленькая супергероиня"
                                   FontSize="14"
                                   TextColor="#4338CA" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#12000000" Radius="14" Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Мои достижения"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#4338CA" />

                    <CollectionView ItemsSource="{Binding Badges}" SelectionMode="None"
                                    ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="120" Margin="0,0,12,0" Padding="16" BackgroundColor="#EEF2FF" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="{Binding Emoji}" FontSize="28" HorizontalOptions="Center" />
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="#4338CA" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="#6366F1" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#12000000" Radius="16" Offset="0,5" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <Label Text="Хочу попробовать"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#4338CA" />
                    <VerticalStackLayout Spacing="12">
                        <Border BackgroundColor="#EEF2FF" StrokeThickness="0" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Научиться готовить завтрак"
                                       FontSize="15"
                                       TextColor="#4338CA" />
                                <Button Grid.Column="1" Text="Начать" Clicked="OnStartIdeaClicked"
                                        BackgroundColor="#6366F1" TextColor="White" CornerRadius="16" Padding="16,8" />
                            </Grid>
                        </Border>
                        <Border BackgroundColor="#EEF2FF" StrokeThickness="0" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Сделать открытку для бабушки"
                                       FontSize="15"
                                       TextColor="#4338CA" />
                                <Button Grid.Column="1" Text="Начать" Clicked="OnStartIdeaClicked"
                                        BackgroundColor="#6366F1" TextColor="White" CornerRadius="16" Padding="16,8" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#12000000" Radius="14" Offset="0,4" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Настройки"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#4338CA" />
                    <Button Text="Сменить аватар" StyleClass="PrimaryButton" BackgroundColor="#6366F1" TextColor="White" CornerRadius="22" Padding="16,10" Clicked="OnChangeAvatarClicked" />
                    <Button Text="Сообщить родителям" BackgroundColor="#E0E7FF" TextColor="#4338CA" CornerRadius="22" Padding="16,10" Clicked="OnContactParentsClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
