<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.CreateFamilyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ChildMotivationApp.ViewModels"
    x:DataType="vm:CreateFamilyPageViewModel"
    BackgroundColor="#F5F7FA"
    Title="Create Family">

    <ScrollView>
        <VerticalStackLayout Padding="20" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"
                            Spacing="0">
            
            <!-- Белая карточка -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    MaximumWidthRequest="500"
                    Padding="50,60"
                    HorizontalOptions="Fill"
                    Margin="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#10000000" Radius="30" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="30" HorizontalOptions="Fill">
                    
                    <!-- Фиолетовая иконка домика -->
                    <Border WidthRequest="80" 
                            HeightRequest="80"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            x:Name="HouseIconBorder">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D946EF" Offset="0.0" />
                                <GradientStop Color="#A855F7" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        
                        <Label Text="🏠"
                               FontSize="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Заголовок -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Создай семью"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        
                        <Label Text="Как называется ваша семья?"
                               FontSize="15"
                               TextColor="#6B7280"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Форма -->
                    <VerticalStackLayout Spacing="12">
                        
                        <!-- Label -->
                        <Label Text="Название семьи"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#374151"
                               Margin="0,0,0,4" />
                        
                        <!-- Input -->
                        <Border BackgroundColor="#F9FAFB"
                                StrokeThickness="1"
                                Stroke="#E5E7EB">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            
                            <Entry Text="{Binding FamilyName, Mode=TwoWay}"
                                   Placeholder="Введите название вашей семьи"
                                   FontSize="15"
                                   TextColor="#1F2937"
                                   PlaceholderColor="#9CA3AF"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   Margin="12,0" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Кнопка с градиентом -->
                    <Label Text="{Binding ValidationMessage}"
                           FontSize="12"
                           TextColor="#DC2626"
                           Margin="4,4,0,0"
                           IsVisible="{Binding HasValidationMessage}" />

                    <Button Text="Создать семью"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="10"
                            Margin="0,10,0,0"
                            Command="{Binding CreateFamilyCommand}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#D946EF" Offset="0.0" />
                                <GradientStop Color="#EC4899" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                            
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
