<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.RoleSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ChildMotivationApp.ViewModels"
    x:DataType="vm:RoleSelectionPageViewModel"
    BackgroundColor="#F5F7FA"
    Title="Choose Your Role">

    <ScrollView>
        <VerticalStackLayout Padding="20" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"
                            Spacing="0">
            
            <!-- Белая карточка -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    MaximumWidthRequest="850"
                    Padding="40,50,40,60"
                    HorizontalOptions="Fill"
                    Margin="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#10000000" Radius="30" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="50" HorizontalOptions="Fill">
                    
                    <!-- Заголовок -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Кто ты в семье?"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        
                        <Label Text="Выбери свою роль"
                               FontSize="16"
                               TextColor="#6B7280"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Карточки ролей - горизонтально -->
                    <Grid ColumnDefinitions="*,40,*" 
                          RowDefinitions="Auto"
                          HorizontalOptions="Center"
                          Margin="10,5,10,5">
                        
                        <!-- Parent Card -->
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                Padding="30,40,30,35"
                                Margin="5"
                                HorizontalOptions="Fill"
                                MaximumWidthRequest="340">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#08000000" Radius="15" Offset="0,4" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectParentCommand}" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#E5E7EB" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Scale" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#3B82F6" />
                                            <Setter Property="StrokeThickness" Value="3" />
                                            <Setter Property="Scale" Value="1.02" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            
                            <VerticalStackLayout Spacing="25" HorizontalOptions="Center">
                                <!-- Icon -->
                                <Border WidthRequest="90" 
                                        HeightRequest="90"
                                        BackgroundColor="#3B82F6"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Image Source="parent.png"
                                           WidthRequest="55"
                                           HeightRequest="55"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Label Text="Родитель"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Создавай задачи и следи за прогрессом"
                                           FontSize="14"
                                           TextColor="#6B7280"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"
                                           MaximumWidthRequest="220" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Child Card -->
                        <Border Grid.Column="2"
                                BackgroundColor="White"
                                Padding="30,40,30,35"
                                Margin="5"
                                HorizontalOptions="Fill"
                                MaximumWidthRequest="340">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#08000000" Radius="15" Offset="0,4" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectChildCommand}" />
                            </Border.GestureRecognizers>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#E5E7EB" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Scale" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#D946EF" />
                                            <Setter Property="StrokeThickness" Value="3" />
                                            <Setter Property="Scale" Value="1.02" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            
                            <VerticalStackLayout Spacing="25" HorizontalOptions="Center">
                                <!-- Icon -->
                                <Border WidthRequest="90" 
                                        HeightRequest="90"
                                        BackgroundColor="#D946EF"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <Ellipse />
                                    </Border.StrokeShape>
                                    <Image Source="child.png"
                                           WidthRequest="55"
                                           HeightRequest="55"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                
                                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Label Text="Ребёнок"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Выполняй задачи и получай награды"
                                           FontSize="14"
                                           TextColor="#6B7280"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"
                                           MaximumWidthRequest="220" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        
                    </Grid>
                            
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
