<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="40" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"
                            MaximumWidthRequest="680">
            
            <!-- Белая карточка как на фото -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="50,60">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#10000000" Radius="30" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="30">
                    
                    <!-- Иконка сердца с ГРАДИЕНТОМ -->
                    <Border WidthRequest="100" 
                            HeightRequest="100"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <Ellipse />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D946EF" Offset="0.0" />
                                <GradientStop Color="#EC4899" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#20D946EF" Radius="20" Offset="0,8" />
                        </Border.Shadow>
                        
                        <!-- Ваше фото сердца -->
                        <Image Source="heart.png"
                               WidthRequest="60"
                               HeightRequest="60"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Заголовок -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Добро пожаловать в"
                               FontSize="22"
                               TextColor="#1F2937"
                               HorizontalOptions="Center" />
                        
                        <!-- Текст с цветом градиента (средний оттенок) -->
                        <Label Text="Семейные Дела"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#E74BAA"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Подзаголовок -->
                    <Label Text="Превращаем домашние обязанности в увлекательную игру! 🎮"
                           FontSize="15"
                           TextColor="#6B7280"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,10" />

                    <!-- Три карточки функций - ИЗОБРАЖЕНИЯ -->
                    <Grid ColumnDefinitions="*,*,*" 
                          ColumnSpacing="20"
                          Margin="0,10,0,0">
                        
                        <!-- Получай очки -->
                        <VerticalStackLayout Grid.Column="0" 
                                            Spacing="12" 
                                            HorizontalOptions="Center">
                            <!-- Ваше фото звезды -->
                            <Image Source="star.png"
                                   WidthRequest="48"
                                   HeightRequest="48"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" />
                            
                            <Label Text="Получай очки"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Text="За каждую выполненную задачу"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <!-- Покупай награды -->
                        <VerticalStackLayout Grid.Column="1" 
                                            Spacing="12" 
                                            HorizontalOptions="Center">
                            <!-- Ваше фото подарка -->
                            <Image Source="gift.png"
                                   WidthRequest="48"
                                   HeightRequest="48"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" />
                            
                            <Label Text="Покупай награды"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Text="Трать очки на желаемые призы"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <!-- Работай в команде -->
                        <VerticalStackLayout Grid.Column="2" 
                                            Spacing="12" 
                                            HorizontalOptions="Center">
                            <!-- Ваше фото команды -->
                            <Image Source="team.png"
                                   WidthRequest="48"
                                   HeightRequest="48"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" />
                            
                            <Label Text="Работай в команде"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Text="Помогай всей семье"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        
                    </Grid>

                    <!-- Кнопка с градиентом -->
                    <Button Text="Начать приключение! 🚀"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            HeightRequest="56"
                            CornerRadius="12"
                            Margin="0,20,0,0"
                            Clicked="OnStartClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#D946EF" Offset="0.0" />
                                <GradientStop Color="#EC4899" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                            
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
