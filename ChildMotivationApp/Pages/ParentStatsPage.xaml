<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.ParentStatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ChildMotivationApp.Controls"
    xmlns:vm="clr-namespace:ChildMotivationApp.ViewModels"
    xmlns:converters="clr-namespace:ChildMotivationApp.Converters"
    x:DataType="vm:ParentStatsPageViewModel"
    BackgroundColor="#F8FAFC"
    Shell.NavBarIsVisible="False"
    Title="Statistics">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="PeriodBackgroundConverter"
                                              TrueColor="#8B5CF6"
                                              FalseColor="#F3F4F6" />
            <converters:BoolToColorConverter x:Key="PeriodTextConverter"
                                              TrueColor="White"
                                              FalseColor="#6B7280" />
            <converters:BoolToColorConverter x:Key="ChartLabelColorConverter"
                                              TrueColor="#8B5CF6"
                                              FalseColor="#9CA3AF" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <!-- Верхняя навигация -->
    <controls:TopNavBar Grid.Row="0" ActiveTab="stats" />

        <!-- Основной контент -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,100" Spacing="20">

                <!-- Заголовок страницы -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="📊 Аналитика семьи"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#1F2937" />
                    <Label Text="Отслеживайте прогресс и достижения всей семьи 📈"
                           FontSize="14"
                           TextColor="#6B7280" />
                </VerticalStackLayout>

                <!-- Карточки статистики (4 колонки) -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <!-- Всего задач -->
                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="#DBEAFE"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="📋"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="4">
                          <Label Text="{Binding TotalTasksTodayDisplay}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="Всего задач"
                                       FontSize="12"
                                       TextColor="#6B7280" />
                                <Label Text="сегодня"
                                       FontSize="11"
                                       TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Выполнено успешно -->
                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="#D1FAE5"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="✅"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="4">
                          <Label Text="{Binding CompletionRateDisplay}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="Выполнено"
                                       FontSize="12"
                                       TextColor="#6B7280" />
                                <Label Text="успешность"
                                       FontSize="11"
                                       TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Очков заработано -->
                    <Border Grid.Column="2"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="#FEF3C7"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="💡"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="4">
                          <Label Text="{Binding TotalPointsEarnedDisplay}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="Очков заработано"
                                       FontSize="12"
                                       TextColor="#6B7280" />
                                <Label Text="всего"
                                       FontSize="11"
                                       TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Активных детей -->
                    <Border Grid.Column="3"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="#FCE7F3"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="👥"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="4">
                          <Label Text="{Binding ActiveChildrenDisplay}"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="Активных детей"
                                       FontSize="12"
                                       TextColor="#6B7280" />
                                <Label Text="участвуют"
                                       FontSize="11"
                                       TextColor="#9CA3AF" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Вкладки: Неделя, Месяц, Год -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            BackgroundColor="{Binding IsWeekSelected, Converter={StaticResource PeriodBackgroundConverter}}"
                            StrokeThickness="0"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePeriodCommand}"
                                                  CommandParameter="Неделя" />
                        </Border.GestureRecognizers>
                        <Label Text="Неделя"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{Binding IsWeekSelected, Converter={StaticResource PeriodTextConverter}}"
                               HorizontalOptions="Center" />
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="{Binding IsMonthSelected, Converter={StaticResource PeriodBackgroundConverter}}"
                            StrokeThickness="0"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePeriodCommand}"
                                                  CommandParameter="Месяц" />
                        </Border.GestureRecognizers>
                        <Label Text="Месяц"
                               FontSize="14"
                               TextColor="{Binding IsMonthSelected, Converter={StaticResource PeriodTextConverter}}"
                               HorizontalOptions="Center" />
                    </Border>
                    <Border Grid.Column="2"
                            BackgroundColor="{Binding IsYearSelected, Converter={StaticResource PeriodBackgroundConverter}}"
                            StrokeThickness="0"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePeriodCommand}"
                                                  CommandParameter="Год" />
                        </Border.GestureRecognizers>
                        <Label Text="Год"
                               FontSize="14"
                               TextColor="{Binding IsYearSelected, Converter={StaticResource PeriodTextConverter}}"
                               HorizontalOptions="Center" />
                    </Border>
                </Grid>

                <!-- График активности по дням -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        <!-- Заголовок графика -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="⚡ Активность по дням"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="Количество выполненных задач за неделю"
                                       FontSize="13"
                                       TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- График активности -->
                        <FlexLayout HeightRequest="280"
                                    Direction="Row"
                                    AlignItems="End"
                                    JustifyContent="SpaceBetween"
                                    Padding="0,20,0,0"
                                    BindableLayout.ItemsSource="{Binding DailyActivity}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DailyActivityPoint">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid VerticalOptions="End" HeightRequest="200">
                                            <BoxView BackgroundColor="#E5E7EB"
                                                     HeightRequest="200"
                                                     CornerRadius="8"
                                                     Opacity="0.3"
                                                     VerticalOptions="End" />
                                            <BoxView CornerRadius="8,8,0,0"
                                                     HeightRequest="{Binding ColumnHeight}"
                                                     VerticalOptions="End">
                                                <BoxView.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#8B5CF6" Offset="0.0" />
                                                        <GradientStop Color="#A78BFA" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </BoxView.Background>
                                            </BoxView>
                                        </Grid>
                                        <Label Text="{Binding DayLabel}"
                                               FontSize="12"
                                               TextColor="{Binding IsHighlighted, Converter={StaticResource ChartLabelColorConverter}}"
                                               HorizontalOptions="Center"
                                               Margin="0,12,0,0" />
                                        <Label Text="{Binding TasksCompleted}"
                                               FontSize="10"
                                               TextColor="{Binding IsHighlighted, Converter={StaticResource ChartLabelColorConverter}}"
                                               HorizontalOptions="Center"
                                               Margin="0,2,0,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Задачи по категориям -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        <Label Text="🎯 Задачи по категориям"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1F2937" />

                        <!-- Пустое состояние -->
                        <VerticalStackLayout Spacing="16" Padding="40" HorizontalOptions="Center">
                            <Border WidthRequest="80"
                                    HeightRequest="80"
                                    BackgroundColor="#F3F4F6"
                                    StrokeThickness="0"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Label Text="🎯"
                                       FontSize="40"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Пока нет выполненных задач"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#6B7280"
                                   HorizontalOptions="Center" />
                            <Label Text="Создайте задачи для детей, чтобы увидеть статистику"
                                   FontSize="14"
                                   TextColor="#9CA3AF"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Условия детей -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#15000000" Radius="20" Offset="0,6" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        <Label Text="👦 Условия детей"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1F2937" />

                        <!-- Пустое состояние -->
                        <VerticalStackLayout Spacing="16" Padding="40" HorizontalOptions="Center">
                            <Border WidthRequest="80"
                                    HeightRequest="80"
                                    BackgroundColor="#F3F4F6"
                                    StrokeThickness="0"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Label Text="👨‍👩‍👧"
                                       FontSize="40"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Пока нет детей в семье"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#6B7280"
                                   HorizontalOptions="Center" />
                            <Label Text="Пригласите детей, чтобы начать отслеживать их прогресс"
                                   FontSize="14"
                                   TextColor="#9CA3AF"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
