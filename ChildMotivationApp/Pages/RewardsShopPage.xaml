<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.RewardsShopPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ChildMotivationApp.Controls"
    xmlns:vm="clr-namespace:ChildMotivationApp.ViewModels"
    x:DataType="vm:RewardsShopPageViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F6FB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8B5CF6" Offset="0" />
                <GradientStop Color="#EC4899" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PrimaryActionGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#6366F1" Offset="0" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="SectionTitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#111827" />
            </Style>

            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#6B7280" />
            </Style>

            <Style x:Key="PrimaryActionButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryActionGradient}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="20,12" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#4C1D95" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>

            <Style x:Key="OverflowButtonBorder" TargetType="Border">
                <Setter Property="WidthRequest" Value="36" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="BackgroundColor" Value="#EEF2FF" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="18" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#08000000" Offset="0,4" Radius="8" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardContainer" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="28" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#0F000000" Radius="18" Offset="0,6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="RewardCardTemplate" x:DataType="vm:RewardItem">
                <Border Style="{StaticResource CardContainer}" Margin="0,0,0,22">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <Ellipse />
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{Binding AccentGradientStart}" Offset="0" />
                                        <GradientStop Color="{Binding AccentGradientEnd}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Image
                                    HeightRequest="36"
                                    HorizontalOptions="Center"
                                    Source="{Binding Icon}"
                                    VerticalOptions="Center"
                                    WidthRequest="36" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label FontAttributes="Bold" FontSize="20" Text="{Binding Title}" TextColor="#111827" />
                                <Label FontSize="14" LineBreakMode="TailTruncation" MaxLines="2" Text="{Binding Description}" TextColor="#4B5563" />
                                <Label FontAttributes="Bold" FontSize="12" Text="{Binding ActivationStatusLabel}" TextColor="#DC2626">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" TargetType="Label" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="10" HorizontalOptions="End" VerticalOptions="Start">
                                <Border
                                    BackgroundColor="#EEF2FF"
                                    IsVisible="{Binding IsFeatured}"
                                    Padding="12,6"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label FontSize="13" Text="🔥" VerticalOptions="Center" />
                                        <Label FontSize="13" FontAttributes="Bold" Text="Хит" TextColor="#4338CA" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Padding="14,9" StrokeThickness="0" BackgroundColor="#F8FAFF">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <CheckBox
                                            SemanticProperties.Description="Состояние награды"
                                            Color="#6366F1"
                                            IsChecked="{Binding IsActive}" />
                                        <Label FontAttributes="Bold" FontSize="13" Text="Активна">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="#166534" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" TargetType="Label" Value="False">
                                                    <Setter Property="TextColor" Value="#B91C1C" />
                                                    <Setter Property="Text" Value="На паузе" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Style="{StaticResource OverflowButtonBorder}" Margin="0,2,0,0">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="17"
                                        HorizontalOptions="Center"
                                        Text="⋯"
                                        TextColor="#4338CA"
                                        VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.ShowRewardOptionsCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Spacing="12">
                            <Border BackgroundColor="{Binding BadgeBackground}" Padding="14,8" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="10">
                                    <Image Source="star.png" HeightRequest="18" WidthRequest="18" />
                                    <Label FontAttributes="Bold" FontSize="13" Text="{Binding CategoryName}" TextColor="#4338CA" />
                                </HorizontalStackLayout>
                            </Border>

                            <HorizontalStackLayout Spacing="10">
                                <Border BackgroundColor="#F1F5F9" Padding="10,6" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger Binding="{Binding Estimation}" TargetType="Border" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estimation}" TargetType="Border" Value="">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label FontSize="12" Text="{Binding Estimation}" TextColor="#475569" />
                                </Border>

                                <Border BackgroundColor="#EEF2FF" Padding="10,6" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger Binding="{Binding Popularity}" TargetType="Border" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Popularity}" TargetType="Border" Value="">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label FontSize="12" Text="{Binding Popularity}" TextColor="#4338CA" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalOptions="End">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label FontSize="18" FontAttributes="Bold" Text="🪙" />
                                <Label FontAttributes="Bold" FontSize="18" Text="{Binding Points, StringFormat='{}{0} очков'}" TextColor="#111827" />
                            </HorizontalStackLayout>

                            <Button
                                Grid.Column="1"
                                Padding="18,10"
                                Style="{StaticResource PrimaryActionButton}"
                                Text="Выдать"
                                IsEnabled="{Binding IsActive}"
                                Command="{Binding BindingContext.RedeemRewardCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,*">
            <controls:TopNavBar Grid.Row="0" ActiveTab="rewards" />

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding FilteredRewards}"
                ItemTemplate="{StaticResource RewardCardTemplate}"
                SelectionMode="None"
                VerticalScrollBarVisibility="Always">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical">
                        <GridItemsLayout.Span>
                            <OnIdiom x:TypeArguments="x:Int32">
                                <OnIdiom.Phone>1</OnIdiom.Phone>
                                <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                <OnIdiom.Desktop>3</OnIdiom.Desktop>
                            </OnIdiom>
                        </GridItemsLayout.Span>
                    </GridItemsLayout>
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout Padding="20,24,20,16" Spacing="26">
                        <Border Background="{StaticResource HeaderGradient}" Padding="28" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <VerticalStackLayout Spacing="16">
                                    <Label Style="{StaticResource SectionTitleLabel}" Text="Магазин наград" TextColor="White" />
                                    <Label FontSize="15" Text="{Binding ActiveFiltersSummary}" TextColor="#F9FAFB" Margin="0,4,0,8" LineBreakMode="WordWrap" MaxLines="2" />
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="22" Margin="0,8,0,0">
                                        <VerticalStackLayout>
                                            <Label FontSize="13" Opacity="0.76" Text="Доступно очков" TextColor="White" />
                                            <Label FontAttributes="Bold" FontSize="24" Text="{Binding AvailablePoints}" TextColor="White" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Margin="18,0,0,0">
                                            <Label FontSize="13" Opacity="0.76" Text="Потрачено в этом месяце" TextColor="White" />
                                            <Label FontAttributes="Bold" FontSize="24" Text="{Binding RedeemedThisMonth}" TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="14" VerticalOptions="Center">
                                    <Button
                                        Padding="22,12"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Text="Добавить награду"
                                        Command="{Binding OpenAddRewardCommand}" />
                                    <Label FontSize="12" HorizontalTextAlignment="Center" Text="Настройте награды под ваши цели" TextColor="#E0E7FF" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <Border BackgroundColor="White" Padding="16,6" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <SearchBar
                                    BackgroundColor="Transparent"
                                    CancelButtonColor="#8B5CF6"
                                    FontSize="14"
                                    HeightRequest="44"
                                    Placeholder="Поиск награды"
                                    Text="{Binding SearchQuery}" />
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="White" Padding="4" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Picker
                                    FontSize="14"
                                    HorizontalOptions="Fill"
                                    ItemsSource="{Binding SortOptions}"
                                    SelectedItem="{Binding SelectedSortOption}"
                                    Title="Сортировка"
                                    TextColor="#4338CA" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="{Binding VisibleRewardsCount, StringFormat='Найдено: {0} наград'}"
                                TextColor="#475569" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource GhostButton}"
                                Text="Сбросить фильтры" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None" HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="14" Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RewardCategory">
                                    <Border Padding="16,10" StrokeThickness="0" BackgroundColor="{Binding BackgroundColor}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                <Setter Property="BackgroundColor" Value="{Binding ActiveBackground}" />
                                                <Setter Property="Shadow">
                                                    <Setter.Value>
                                                        <Shadow Brush="#208B5CF6" Offset="0,4" Radius="12" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <HorizontalStackLayout Spacing="10">
                                            <Image HeightRequest="20" Source="{Binding Icon}" WidthRequest="20" />
                                            <Label FontSize="14" Text="{Binding DisplayName}" TextColor="{Binding TextColor}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleCategoryCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <Border Margin="20,40" Padding="28" BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,6" Radius="18" />
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="12" VerticalOptions="Center">
                            <Label FontSize="48" HorizontalOptions="Center" Text="✨" />
                            <Label FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" Text="Ничего не найдено" TextColor="#111827" />
                            <Label FontSize="14" HorizontalTextAlignment="Center" Text="Попробуйте изменить фильтры или добавить новую награду" TextColor="#6B7280" />
                            <Button
                                Margin="0,6,0,0"
                                Padding="20,10"
                                Style="{StaticResource PrimaryActionButton}"
                                Text="Создать награду"
                                Command="{Binding OpenAddRewardCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsEditorVisible}" Padding="20">
            <Border
                BackgroundColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="26"
                MaximumWidthRequest="520"
                StrokeThickness="0"
                x:DataType="vm:RewardEditorState"
                BindingContext="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditorState}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1A000000" Offset="0,16" Radius="28" />
                </Border.Shadow>

                <ScrollView>
                    <VerticalStackLayout Spacing="20">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label FontAttributes="Bold" FontSize="20" Text="{Binding HeaderTitle}" TextColor="#111827" />
                            <Button
                                Grid.Column="1"
                                Text="✕"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                FontSize="18"
                                Padding="6"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelEditorCommand}" />
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label FontAttributes="Bold" FontSize="14" Text="Название" TextColor="#111827" />
                            <Border BackgroundColor="#F5F5FB" Padding="14,0" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Entry
                                    Text="{Binding Title}"
                                    Placeholder="Например, Совместное мороженое"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    TextColor="#111827"
                                    PlaceholderColor="#9CA3AF" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label FontAttributes="Bold" FontSize="14" Text="Описание" TextColor="#111827" />
                            <Border BackgroundColor="#F5F5FB" Padding="14,6" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Editor
                                    AutoSize="TextChanges"
                                    BackgroundColor="Transparent"
                                    Placeholder="Добавьте детали награды"
                                    PlaceholderColor="#9CA3AF"
                                    Text="{Binding Description}"
                                    TextColor="#111827"
                                    FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label FontAttributes="Bold" FontSize="14" Text="Категория" TextColor="#111827" />
                                <Border BackgroundColor="#F5F5FB" Padding="4" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Picker
                                        ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditorCategories}"
                                        SelectedItem="{Binding SelectedCategory}"
                                        ItemDisplayBinding="{Binding DisplayName}"
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        TextColor="#111827" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label FontAttributes="Bold" FontSize="14" Text="Очки" TextColor="#111827" />
                                <Border BackgroundColor="#F5F5FB" Padding="0" StrokeThickness="0" HorizontalOptions="Fill">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Entry
                                        Text="{Binding PointsInput}"
                                        Keyboard="Numeric"
                                        FontSize="14"
                                        HorizontalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        TextColor="#111827"
                                        Placeholder="0" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label FontAttributes="Bold" FontSize="14" Text="Оценка длительности" TextColor="#111827" />
                                <Border BackgroundColor="#F5F5FB" Padding="14,0" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Entry
                                        Text="{Binding Estimation}"
                                        Placeholder="Например, ~1 час"
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        TextColor="#111827"
                                        PlaceholderColor="#9CA3AF" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label FontAttributes="Bold" FontSize="14" Text="Популярность" TextColor="#111827" />
                                <Border BackgroundColor="#F5F5FB" Padding="14,0" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>
                                    <Entry
                                        Text="{Binding Popularity}"
                                        Placeholder="Например, Любимый десерт"
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        TextColor="#111827"
                                        PlaceholderColor="#9CA3AF" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border BackgroundColor="#EEF2FF" Padding="16" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                    <CheckBox
                                        SemanticProperties.Description="Отметить награду как хит"
                                        Color="#4338CA"
                                        IsChecked="{Binding IsFeatured}" />
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" FontSize="14" Text="Избранная награда" TextColor="#4338CA" />
                                        <Label FontSize="12" Text="Показывается с меткой «Хит»" TextColor="#4B5563" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="#F1F5F9" Padding="16" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="22" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                    <CheckBox
                                        SemanticProperties.Description="Активировать награду"
                                        Color="#0F172A"
                                        IsChecked="{Binding IsActive}" />
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" FontSize="14" Text="Активна" TextColor="#0F172A">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" TargetType="Label" Value="False">
                                                    <Setter Property="Text" Value="На паузе" />
                                                    <Setter Property="TextColor" Value="#B91C1C" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label FontSize="12" Text="Награда появится в выдаче">
                                            <Label.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" TargetType="Label" Value="False">
                                                    <Setter Property="Text" Value="Включите, чтобы сделать награду доступной" />
                                                    <Setter Property="TextColor" Value="#B91C1C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" TargetType="Label" Value="True">
                                                    <Setter Property="TextColor" Value="#4B5563" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Label
                            BackgroundColor="#FEE2E2"
                            Padding="14,10"
                            Text="{Binding ErrorMessage}"
                            TextColor="#B91C1C"
                            FontSize="13"
                            IsVisible="{Binding HasError}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Button
                                Text="Отмена"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelEditorCommand}" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource PrimaryActionButton}"
                                Text="{Binding SaveButtonText}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SaveRewardCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>

</ContentPage>