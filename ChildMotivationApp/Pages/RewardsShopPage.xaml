                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Margin="24,0,24,16" Spacing="16" VerticalOptions="End">
                            <Label Text="30 минут игры в любимую видеоигру." FontSize="16" TextColor="#374151" LineBreakMode="WordWrap"/>
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="https://img.icons8.com/color/32/coins.png" WidthRequest="24" HeightRequest="24"/>
                                <Label Text="80 очков" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="16,0,0,0">
                                    <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#E0E7FF" StrokeThickness="0">
