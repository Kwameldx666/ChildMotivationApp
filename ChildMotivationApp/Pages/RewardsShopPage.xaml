<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.RewardsShopPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Магазин наград"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F9FAFB">

    <Grid Padding="16,16,16,24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">

        <!-- Gradient Header -->
        <Border Grid.Row="0" HeightRequest="104" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#8B5CF6" Offset="0.0"/>
                    <GradientStop Color="#A78BFA" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="24,0">
                <HorizontalStackLayout Grid.Column="0" Spacing="16" VerticalOptions="Center">
                    <Image Source="https://img.icons8.com/color/96/gift.png" WidthRequest="40" HeightRequest="40"/>
                    <Label Text="Магазин наград" FontSize="30" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Border Grid.Column="2" BackgroundColor="#FFFFFF66" StrokeThickness="0" Padding="12,8" WidthRequest="140" HeightRequest="56">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="https://img.icons8.com/fluency/48/plus-math.png" WidthRequest="24" HeightRequest="24"/>
                        <Label Text="Добавить" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Filter Chips (in one row) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Border BackgroundColor="#FFF5F3FF" StrokeThickness="0" Padding="16,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="Education" TextColor="#8B5CF6" FontAttributes="Bold" FontSize="14"/>
                </Border>
                <Border BackgroundColor="#FFE0F7FA" StrokeThickness="0" Padding="16,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="Household" TextColor="#00B9C2" FontAttributes="Bold" FontSize="14"/>
                </Border>
                <Border BackgroundColor="#FFFEE4EF" StrokeThickness="0" Padding="16,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="Fun" TextColor="#F06292" FontAttributes="Bold" FontSize="14"/>
                </Border>
                <Border BackgroundColor="#FFE8F5E9" StrokeThickness="0" Padding="16,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="Long Term" TextColor="#388E3C" FontAttributes="Bold" FontSize="14"/>
                </Border>
                <Border BackgroundColor="#FFFFF3E0" StrokeThickness="0" Padding="16,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="Food" TextColor="#FFB300" FontAttributes="Bold" FontSize="14"/>
                </Border>
                <Border BackgroundColor="#FFF4F6F8" StrokeThickness="0" Padding="16,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="Other" TextColor="#7B809A" FontAttributes="Bold" FontSize="14"/>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Controls Row -->
        <HorizontalStackLayout Grid.Row="2" Spacing="16">
            <Picker WidthRequest="200" HeightRequest="32" Title="Сортировать" FontSize="14">
                <Picker.Items>
                    <x:String>Сортировать по очкам</x:String>
                    <x:String>Сортировать по названию</x:String>
                </Picker.Items>
            </Picker>
            <Border BackgroundColor="#F4F4F4" StrokeThickness="0" Padding="12,6" WidthRequest="184" HeightRequest="32">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="https://img.icons8.com/fluency-systems-regular/24/settings.png" WidthRequest="18" HeightRequest="18"/>
                    <Label Text="Режим управления" FontSize="15" FontAttributes="Bold"/>
                </HorizontalStackLayout>
            </Border>
        </HorizontalStackLayout>

        <!-- Reward Cards Block -->
        <ScrollView Grid.Row="3">
            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">

                <!-- Card 1: Movie night choice (Fun) -->
                <Border WidthRequest="320" HeightRequest="200" Margin="0,0,24,24" BackgroundColor="White" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#18000000" Radius="12" Offset="0,4"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,*">
                        <HorizontalStackLayout Grid.Row="0" Spacing="16" Margin="24,16,24,0">
                            <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <Ellipse/>
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FAC1E7" Offset="0.0"/>
                                        <GradientStop Color="#A78BFA" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Image Source="https://img.icons8.com/color/96/popcorn.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Movie night choice" FontSize="20" FontAttributes="Bold"/>
                                <Label Text="Category: Fun" FontSize="14" TextColor="#F06292"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Margin="24,0,24,16" Spacing="16" VerticalOptions="End">
                            <Label Text="Провести вечер за просмотром фильма всей семьёй." FontSize="16" TextColor="#374151" LineBreakMode="WordWrap"/>
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="https://img.icons8.com/color/32/coins.png" WidthRequest="24" HeightRequest="24"/>
                                <Label Text="120 очков" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,0,100,0">
                                    <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#E0E7FF" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Image Source="https://img.icons8.com/material/24/edit--v1.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#FDE0E0" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Image Source="https://img.icons8.com/material/24/delete-forever--v1.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Border WidthRequest="32" HeightRequest="32" BackgroundColor="#68C288" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <Ellipse/>
                                        </Border.StrokeShape>
                                    </Border>
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Card 2: Ice Cream (Food) -->
                <Border WidthRequest="320" HeightRequest="200" Margin="0,0,24,24" BackgroundColor="White" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#18000000" Radius="12" Offset="0,4"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,*">
