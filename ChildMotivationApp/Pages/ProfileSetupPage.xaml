<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.ProfileSetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F7FA"
    Title="Profile Setup">

    <ScrollView>
        <VerticalStackLayout Padding="40" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"
                            MaximumWidthRequest="480">
            
            <!-- Чистая белая карточка -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="40,50">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#10000000" Radius="30" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="30">
                    
                    <!-- Заголовок -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label x:Name="PageTitleLabel"
                               Text="Расскажи о себе"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               HorizontalOptions="Center" />
                        
                        <Label x:Name="PageSubtitleLabel"
                               Text="Создай свой профиль"
                               FontSize="14"
                               TextColor="#6B7280"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Простой аватар -->
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        
                        <!-- Avatar Circle - ИЗОБРАЖЕНИЕ avatar.png -->
                        <Border WidthRequest="100" 
                                HeightRequest="100"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                x:Name="AvatarBorder">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#20000000" Radius="15" Offset="0,5" />
                            </Border.Shadow>
                            
                            <!-- Динамическое изображение -->
                            <Image x:Name="AvatarIcon"
                                   WidthRequest="60"
                                   HeightRequest="60"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Role Badge -->
                        <Border Padding="16,8"
                                BackgroundColor="#F3F4F6"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                x:Name="RoleBadge">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            
                            <Label x:Name="RoleLabel"
                                   Text="Родитель"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#374151"
                                   HorizontalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Форма -->
                    <VerticalStackLayout Spacing="24">
                        
                        <!-- Name Input -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Как тебя зовут?"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#374151" />
                            
                            <Border BackgroundColor="#F9FAFB"
                                    StrokeThickness="1"
                                    Stroke="#E5E7EB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                
                                <Entry x:Name="NameEntry"
                                       Placeholder="Введи своё имя"
                                       FontSize="15"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48"
                                       Margin="12,0" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Age Input (только для детей) -->
                        <VerticalStackLayout x:Name="AgeSection" 
                                           Spacing="8"
                                           IsVisible="False">
                            <Label Text="Сколько тебе лет?"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#374151" />
                            
                            <Border BackgroundColor="#F9FAFB"
                                    StrokeThickness="1"
                                    Stroke="#E5E7EB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                
                                <Grid ColumnDefinitions="50,*,50" HeightRequest="48">
                                    
                                    <Button Grid.Column="0"
                                            Text="−"
                                            FontSize="24"
                                            TextColor="#6B7280"
                                            BackgroundColor="Transparent"
                                            Clicked="OnDecreaseAgeClicked" />
                                    
                                    <Entry x:Name="AgeEntry"
                                           Grid.Column="1"
                                           Text="8"
                                           Keyboard="Numeric"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937"
                                           BackgroundColor="Transparent"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextChanged="OnAgeTextChanged" />
                                    
                                    <Button Grid.Column="2"
                                            Text="+"
                                            FontSize="20"
                                            TextColor="#6B7280"
                                            BackgroundColor="Transparent"
                                            Clicked="OnIncreaseAgeClicked" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- Простая кнопка -->
                    <Button x:Name="ContinueButton"
                            Text="Продолжить"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#6B7280"
                            HeightRequest="50"
                            CornerRadius="10"
                            Margin="0,10,0,0"
                            Clicked="OnContinueClicked" />
                            
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
