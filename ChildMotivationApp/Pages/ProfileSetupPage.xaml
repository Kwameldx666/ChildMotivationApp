<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChildMotivationApp.Pages.ProfileSetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ChildMotivationApp.ViewModels"
    x:DataType="vm:ProfileSetupPageViewModel"
    BackgroundColor="#F5F7FA"
    Title="Profile Setup">

    <ScrollView>
        <VerticalStackLayout Padding="40" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"
                            MaximumWidthRequest="480">
            
            <!-- Чистая белая карточка -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="40,50">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#10000000" Radius="30" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="30">
                    
                    <!-- Заголовок -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
               <Label Text="{Binding PageTitle}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#1F2937"
                               HorizontalOptions="Center" />
                        
               <Label Text="{Binding PageSubtitle}"
                               FontSize="14"
                               TextColor="#6B7280"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Простой аватар -->
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        
                        <!-- Avatar Circle - ИЗОБРАЖЕНИЕ avatar.png -->
                        <Border WidthRequest="100" 
                                HeightRequest="100"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <Ellipse />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#20000000" Radius="15" Offset="0,5" />
                            </Border.Shadow>
                            <Border.Background>
                                <SolidColorBrush Color="{Binding PrimaryColor}" />
                            </Border.Background>
                            
                            <!-- Динамическое изображение -->
                <Image Source="{Binding AvatarImage}"
                    WidthRequest="60"
                    HeightRequest="60"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
                        </Border>

                        <!-- Role Badge -->
                        <Border Padding="16,8"
                                BackgroundColor="{Binding BadgeBackground}"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                <Label Text="{Binding RoleLabel}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                    TextColor="{Binding RoleTextColor}"
                                   HorizontalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Форма -->
                    <VerticalStackLayout Spacing="24">
                        
                        <!-- Name Input -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Как тебя зовут?"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#374151" />
                            
                <Border BackgroundColor="#F9FAFB"
                    StrokeThickness="1"
                    Stroke="#E5E7EB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                
                    <Entry Text="{Binding Name}"
                        Placeholder="Введи своё имя"
                                       FontSize="15"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48"
                                       Margin="12,0" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Age Input (только для детей) -->
                        <VerticalStackLayout Spacing="8"
                                           IsVisible="{Binding ShowAgeSection}">
                            <Label Text="Сколько тебе лет?"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#374151" />
                            
                            <Border BackgroundColor="#F9FAFB"
                                    StrokeThickness="1"
                                    Stroke="#E5E7EB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                
                                <Grid ColumnDefinitions="50,*,50" HeightRequest="48">
                                    
                    <Button Grid.Column="0"
                        Text="−"
                                            FontSize="24"
                                            TextColor="#6B7280"
                                            BackgroundColor="Transparent"
                        Command="{Binding DecreaseAgeCommand}" />
                                    
                     <Entry Grid.Column="1"
                         Text="{Binding AgeText, Mode=TwoWay}"
                                           Keyboard="Numeric"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937"
                                           BackgroundColor="Transparent"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                         />
                                    
                    <Button Grid.Column="2"
                        Text="+"
                                            FontSize="20"
                                            TextColor="#6B7280"
                                            BackgroundColor="Transparent"
                        Command="{Binding IncreaseAgeCommand}" />
                                </Grid>
                            </Border>
                <Label Text="{Binding ValidationMessage}"
                    FontSize="12"
                    TextColor="#DC2626"
                    Margin="4,4,0,0"
                    IsVisible="{Binding HasValidationMessage}" />
               </VerticalStackLayout>

                    </VerticalStackLayout>

                    <!-- Простая кнопка -->
                    <Button Text="Продолжить"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            Command="{Binding ContinueCommand}"
                            HeightRequest="50"
                            CornerRadius="10"
                            Margin="0,10,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{Binding ContinueGradientStart}" Offset="0" />
                                <GradientStop Color="{Binding ContinueGradientEnd}" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                            
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
