<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChildMotivationApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ChildMotivationApp.Pages"
    Title="ChildMotivationApp"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <!-- Красивые стили навигации -->
    <Shell.Resources>
        <ResourceDictionary>
            <!-- Gradient Navigation Bar Color -->
            <LinearGradientBrush x:Key="NavigationBarGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#8B5CF6" Offset="0.0" />
                <GradientStop Color="#A78BFA" Offset="1.0" />
            </LinearGradientBrush>
            
            <!-- Navigation Bar Style -->
            <Style TargetType="NavigationPage">
                <Setter Property="BarTextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Красивый Flyout Header для десктопа -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Primary}" HeightRequest="200">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource PrimaryPurple}" Offset="0" />
                    <GradientStop Color="{StaticResource PrimaryPink}" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <Label Text="👨‍👩‍👧‍👦" FontSize="40" HorizontalOptions="Center" />
                <Label Text="Family Tasks" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                <Label Text="Organize • Complete • Reward" FontSize="12" TextColor="White" Opacity="0.8" HorizontalOptions="Center" />
            </StackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Основная навигация приложения - TabBar (скрыта по умолчанию) -->
    <TabBar x:Name="MainTabBar" IsVisible="False">
        
        <!-- Главная -->
        <Tab Title="Главная" Route="home">
            <Tab.Icon>
                <FontImageSource 
                    Glyph="🏠" 
                    FontFamily="Default" 
                    Size="24" 
                    Color="{AppThemeBinding Light=#8B5CF6, Dark=#A78BFA}" />
            </Tab.Icon>
            <ShellContent Route="dashboard" ContentTemplate="{DataTemplate local:DashboardPage}" />
        </Tab>

        <!-- Награды магазин -->
        <Tab Title="Награды" Route="rewards">
            <Tab.Icon>
                <FontImageSource 
                    Glyph="🏆" 
                    FontFamily="Default" 
                    Size="24" 
                    Color="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            </Tab.Icon>
            <ShellContent Route="rewards_shop" ContentTemplate="{DataTemplate local:RewardsShopPage}" />
        </Tab>

        <!-- Профиль -->
        <Tab Title="Профиль" Route="profile">
            <Tab.Icon>
                <FontImageSource 
                    Glyph="👤" 
                    FontFamily="Default" 
                    Size="24" 
                    Color="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            </Tab.Icon>
            <ShellContent Route="profilepage" ContentTemplate="{DataTemplate local:DashboardPage}" />
        </Tab>
        
    </TabBar>

    <!-- Стартовые страницы -->
    <ShellContent
        Title="Welcome"
        Route="welcome"
        ContentTemplate="{DataTemplate local:WelcomePage}"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Title="Role Selection"
        Route="roleselection"
        ContentTemplate="{DataTemplate local:RoleSelectionPage}"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Title="Profile Setup"
        Route="profilesetup"
        ContentTemplate="{DataTemplate local:ProfileSetupPage}"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <ShellContent
        Title="Create Family"
        Route="createfamily"
        ContentTemplate="{DataTemplate local:CreateFamilyPage}"
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False" />

    <!-- Flyout Menu для десктопа/планшета -->
    <FlyoutItem Title="Dashboard" Icon="home.png" Route="flyout_dashboard" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Tasks" Icon="tasks.png" Route="flyout_tasks" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Rewards" Icon="rewards.png" Route="flyout_rewards" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Family Members" Icon="family.png" Route="flyout_family" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Profile" Icon="profile.png" Route="flyout_profile" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Icon="settings.png" Route="flyout_settings" IsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" />
    </FlyoutItem>

</Shell>
